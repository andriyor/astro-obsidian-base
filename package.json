{
  "name": "astro-obsidian-base",
  "version": "0.1.0",
  "description": "Render Obsidian Bases (.base) tables in Astro sites from committed snapshots",
  "type": "module",
  "license": "MIT",
  "author": "Andrii Oriekhov <andriyorehov@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andriyor/astro-obsidian-base.git"
  },
  "keywords": [
    "astro-component",
    "obsidian",
    "obsidian-bases"
  ],
  "bin": {
    "astro-obsidian-base": "src/cli.js"
  },
  "exports": {
    "./ObsidianBase.astro": "./src/ObsidianBase.astro",
    "./types": "./src/types.ts"
  },
  "files": [
    "src"
  ],
  "dependencies": {
    "mdbasequery": "^0.0.2",
    "tsx": "^4.23.15"
  },
  "peerDependencies": {
    "astro": ">=4"
  },
  "scripts": {
    "typecheck": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^7.0.2"
  }
}
